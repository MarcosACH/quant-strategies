# API Keys
ALPHA_VANTAGE_API_KEY=your_key_here
POLYGON_API_KEY=your_key_here
IEX_API_KEY=your_key_here
YAHOO_FINANCE_API_KEY=your_key_here

# Database Configuration
DATABASE_URL=sqlite:///data/trading_data.db
REDIS_URL=redis://localhost:6379

# QuestDB Connection (used by data ingestion + backtest queries)
# Defaults below match the bundled docker-compose QuestDB; point these at a
# remote host to use an existing instance.
QUESTDB_HOST=localhost
QUESTDB_PG_PORT=8812    # PostgreSQL wire protocol — queries
QUESTDB_ILP_PORT=9000   # REST/ILP — ingestion

# Grid-search parallelism (joblib n_jobs). Default 1 is memory-safe; -1 uses all
# cores but can OOM during numba compilation. Raise it if you have spare RAM.
MAX_PARALLEL_JOBS=1
